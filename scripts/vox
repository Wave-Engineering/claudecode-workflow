#!/usr/bin/env bash
# vox — Text-to-speech announcements for Claude Code agents
#
# vox resolves a user-supplied *provider* (synthesis) and *player* (playback)
# via the hook pattern. Providers live at ~/.config/vox/provider; examples for
# common setups ship in scripts/vox-providers/. Run `vox --setup` to pick one.
#
# Usage:
#   vox "Hey BJ, deployment is done"
#   echo "Build failed" | vox
#   vox --voice Jade "Tests are passing"
#   vox --output /tmp/memo.wav "Voice memo for Discord"
#   vox --setup                             # interactive first-run setup
#   vox --setup --non-interactive --pick=silent
#   vox --help
#
# Provider contract (see scripts/vox-providers/README.md):
#   Input:  text as $1 (or stdin if $1 is empty)
#   Output: audio file written to $VOX_OUTPUT_FILE
#   Exit:   0 success, non-zero failure
#
# Resolution (first match wins):
#   Provider: $VOX_PROVIDER → ~/.config/vox/provider → bundled silent.sh
#   Player:   $VOX_PLAYER   → ~/.config/vox/player   → autodetect (afplay/paplay/aplay/ffplay)
#
# Environment passed through to the provider:
#   VOX_VOICE, VOX_MODEL, VOX_ENDPOINT, VOX_* (anything else prefixed VOX_)
#
# Special:
#   VOX_DISABLED=1   No audio, clean exit 0 (CI/headless/debug)
#
# Exit codes:
#   0  Success (or disabled)
#   1  Provider failed, player failed, or bad arguments

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/vox"
BUNDLED_PROVIDERS_DIR="$SCRIPT_DIR/vox-providers"

# --- Resolve provider ---------------------------------------------------------

resolve_provider() {
	local p=""
	if [[ -n "${VOX_PROVIDER:-}" ]]; then
		p="$VOX_PROVIDER"
		[[ -x "$p" ]] || {
			echo "vox: \$VOX_PROVIDER ($p) is not executable" >&2
			return 1
		}
		echo "$p"
		return 0
	fi
	if [[ -x "$USER_CONFIG_DIR/provider" ]]; then
		echo "$USER_CONFIG_DIR/provider"
		return 0
	fi
	if [[ -x "$BUNDLED_PROVIDERS_DIR/silent.sh" ]]; then
		echo "$BUNDLED_PROVIDERS_DIR/silent.sh"
		return 0
	fi
	echo "vox: no provider found (tried \$VOX_PROVIDER, $USER_CONFIG_DIR/provider, $BUNDLED_PROVIDERS_DIR/silent.sh)" >&2
	return 1
}

# --- Resolve player -----------------------------------------------------------

resolve_player() {
	if [[ -n "${VOX_PLAYER:-}" ]]; then
		echo "$VOX_PLAYER"
		return 0
	fi
	if [[ -x "$USER_CONFIG_DIR/player" ]]; then
		echo "$USER_CONFIG_DIR/player"
		return 0
	fi
	if [[ "$(uname -s)" == "Darwin" ]] && command -v afplay &>/dev/null; then
		echo "afplay"
		return 0
	fi
	if command -v paplay &>/dev/null; then
		echo "paplay"
		return 0
	fi
	if command -v aplay &>/dev/null; then
		echo "aplay -q"
		return 0
	fi
	if command -v ffplay &>/dev/null; then
		echo "ffplay -nodisp -autoexit -loglevel quiet"
		return 0
	fi
	echo ""
	return 0
}

# --- Resolve speaker identity -------------------------------------------------
# Who is announcing? Walk up the process tree from vox's parent to the owning
# `claude --session-id <uuid>` process, take its cwd, and resolve
# <cwd>/.claude/agent-identity.json -> dev_name. Fallbacks: short session id,
# then the caller PID. Defensive throughout so a failed lookup never breaks vox.
resolve_speaker() {
	local name="" sid="" pid cmd cwd d hop=0
	local have_jq=0
	command -v jq >/dev/null 2>&1 && have_jq=1

	# name_from_cwd DIR : echo dev_name from the nearest ancestor dir carrying
	# .claude/agent-identity.json, walking up from DIR. Empty if none.
	name_from_cwd() {
		local d="$1"
		((have_jq)) || return 0
		while [[ -n "$d" && "$d" != "/" ]]; do
			if [[ -f "$d/.claude/agent-identity.json" ]]; then
				jq -r '.dev_name // empty' "$d/.claude/agent-identity.json" 2>/dev/null || true
				return 0
			fi
			d="$(dirname "$d")"
		done
	}

	# 1) Primary: vox's own cwd (agents invoke it from their project root).
	name="$(name_from_cwd "$PWD")" || name=""

	# 2) Walk the process tree: capture a session id (for the fallback label) and,
	#    if cwd gave no name, try each ancestor's cwd (catches the session's dir
	#    even if the agent cd'd elsewhere).
	pid="${PPID:-0}"
	while [[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 1)) && ((hop < 14)); do
		hop=$((hop + 1))
		cmd="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null)" || cmd=""
		if [[ -z "$sid" && "$cmd" == *"--session-id"* ]]; then
			sid="$(printf '%s ' "$cmd" | sed -n 's/.*--session-id[= ]\([0-9a-fA-F-]\{36\}\).*/\1/p')" || sid=""
		fi
		if [[ -z "$name" ]]; then
			cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null)" || cwd=""
			if [[ -n "$cwd" ]]; then
				name="$(name_from_cwd "$cwd")"
			fi
		fi
		[[ -n "$name" && -n "$sid" ]] && break
		pid="$(awk '/^PPid:/{print $2; exit}' "/proc/$pid/status" 2>/dev/null)" || pid=""
		[[ -n "$pid" ]] || break
	done

	if [[ -n "$name" ]]; then
		printf '%s' "$name"
	elif [[ -n "$sid" ]]; then
		printf 'session %s' "${sid:0:8}"
	else
		printf 'pid %s' "${PPID:-unknown}"
	fi
}

# --- Provenance log -----------------------------------------------------------
# Append one JSON line per announcement to ~/.claude/logs/vox.jsonl, capturing
# the caller's lineage AT CALL TIME (parent cmdline + cwd + a 6-deep ancestor
# cmdline chain) — so a fire-and-exit caller is still traceable after it's gone.
# VOX_NO_LOG=1 to skip. Best-effort; never breaks vox.
vox_log() {
	if [[ "${VOX_NO_LOG:-0}" == "1" ]]; then return 0; fi
	command -v jq >/dev/null 2>&1 || return 0
	local logdir="$HOME/.claude/logs" logf ts ppid pcmd pcwd pid hop cmd chainjson
	local -a chain=()
	logf="$logdir/vox.jsonl"
	mkdir -p "$logdir" 2>/dev/null || return 0
	ts="$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ 2>/dev/null || true)"
	ppid="${PPID:-0}"
	[[ "$ppid" =~ ^[0-9]+$ ]] || ppid=0
	pcmd="$(tr '\0' ' ' <"/proc/$ppid/cmdline" 2>/dev/null || true)"
	pcmd="${pcmd% }"
	pcwd="$(readlink "/proc/$ppid/cwd" 2>/dev/null || true)"
	pid="$ppid"
	hop=0
	while [[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 1)) && ((hop < 6)); do
		hop=$((hop + 1))
		cmd="$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)"
		cmd="${cmd% }"
		if [[ -n "$cmd" ]]; then
			chain+=("$cmd")
		fi
		pid="$(awk '/^PPid:/{print $2; exit}' "/proc/$pid/status" 2>/dev/null || true)"
		[[ -n "$pid" ]] || break
	done
	chainjson='[]'
	if ((${#chain[@]})); then
		chainjson="$(printf '%s\n' "${chain[@]}" | jq -R . | jq -sc . 2>/dev/null || echo '[]')"
	fi
	jq -cn --arg ts "$ts" --arg sp "${1:-}" --arg txt "${2:0:240}" \
		--argjson ppid "$ppid" --arg caller "$pcmd" --arg cwd "$pcwd" --argjson chain "$chainjson" \
		'{ts:$ts, speaker:$sp, ppid:$ppid, cwd:$cwd, caller:$caller, chain:$chain, text:$txt}' \
		>>"$logf" 2>/dev/null || true
	return 0
}

# --- Usage / help -------------------------------------------------------------

usage() {
	cat <<-'USAGE'
		Usage: vox [OPTIONS] [MESSAGE...]

		Options:
		  --voice NAME       Voice name (exported as VOX_VOICE to the provider)
		  --bg               Background playback (don't wait for audio to finish)
		  --output, -o FILE  Write audio to FILE instead of playing
		  --setup [FLAGS]    Interactive first-run setup; picks a provider
		  -h, --help         Show this help

		Setup flags:
		  --non-interactive  Don't prompt; use --pick to select
		  --pick NAME        Provider name (silent|openai-endpoint|openai-qwen|piper-local|espeak|macos-say)

		Message can be passed as arguments or piped via stdin.

		Provider: see ~/.config/vox/provider; contract in scripts/vox-providers/README.md.
		Set VOX_DISABLED=1 to no-op cleanly (for CI / headless).
	USAGE
}

# --- Setup subcommand ---------------------------------------------------------

do_setup() {
	local non_interactive=false
	local pick=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--non-interactive)
			non_interactive=true
			shift
			;;
		--pick)
			pick="${2:-}"
			shift 2
			;;
		--pick=*)
			pick="${1#--pick=}"
			shift
			;;
		*)
			echo "vox --setup: unknown flag '$1'" >&2
			return 1
			;;
		esac
	done

	if $non_interactive && [[ -z "$pick" ]]; then
		echo "vox --setup --non-interactive requires --pick NAME" >&2
		return 1
	fi

	if [[ ! -d "$BUNDLED_PROVIDERS_DIR" ]]; then
		echo "vox --setup: bundled providers dir not found at $BUNDLED_PROVIDERS_DIR" >&2
		return 1
	fi

	if ! $non_interactive; then
		echo "vox setup"
		echo ""
		echo "Available providers:"
		echo "  silent           — no-op (writes 0.1s silence; safe default)"
		echo "  openai-endpoint  — any OpenAI-compatible TTS API (VOX_ENDPOINT)"
		echo "  openai-qwen      — OpenAI-extended TTS (qwen3-tts, Chatterbox) — adds VOX_EMOTION"
		echo "  piper-local      — local piper binary (VOX_PIPER_MODEL)"
		echo "  espeak           — espeak-ng fallback (no network)"
		echo "  macos-say        — macOS say(1)"
		echo ""
		printf "Pick one: "
		read -r pick
	fi

	local src="$BUNDLED_PROVIDERS_DIR/${pick}.sh"
	if [[ ! -x "$src" ]]; then
		echo "vox --setup: no provider named '$pick' (looked for $src)" >&2
		return 1
	fi

	mkdir -p "$USER_CONFIG_DIR"
	ln -sf "$src" "$USER_CONFIG_DIR/provider"
	echo "vox: $USER_CONFIG_DIR/provider → $src"
}

# --- Parse args ---------------------------------------------------------------

VOICE="${VOX_VOICE:-}"
BACKGROUND=false
OUTPUT_FILE=""
args=()

while [[ $# -gt 0 ]]; do
	case "$1" in
	--voice)
		VOICE="${2:-}"
		[[ -z "$VOICE" ]] && {
			echo "Error: --voice requires a name" >&2
			exit 1
		}
		shift 2
		;;
	--bg)
		BACKGROUND=true
		shift
		;;
	--output | -o)
		OUTPUT_FILE="${2:-}"
		[[ -z "$OUTPUT_FILE" ]] && {
			echo "Error: --output requires a file path" >&2
			exit 1
		}
		shift 2
		;;
	--setup)
		shift
		do_setup "$@"
		exit $?
		;;
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		args+=("$@")
		break
		;;
	-*)
		echo "Error: unknown option '$1'" >&2
		exit 1
		;;
	*)
		args+=("$1")
		shift
		;;
	esac
done

# --- VOX_DISABLED short-circuit -----------------------------------------------

if [[ "${VOX_DISABLED:-0}" == "1" ]]; then
	exit 0
fi

# --- Collect message text -----------------------------------------------------

if [[ ${#args[@]} -gt 0 ]]; then
	TEXT="${args[*]}"
elif [[ ! -t 0 ]]; then
	TEXT="$(cat)"
else
	echo "Error: no message provided. Pass as arguments or pipe via stdin." >&2
	exit 1
fi

if [[ -z "${TEXT//[$' \t\n\r']/}" ]]; then
	echo "Error: empty message" >&2
	exit 1
fi

# --- Identify + log the caller, then sign off ---------------------------------
# Resolve who is speaking, LOG the call with full caller lineage (captured now so
# a fire-and-exit caller is still traceable), then append the speaker to the
# spoken text. VOX_NO_SIGNOFF=1 skips the sign-off; VOX_NO_LOG=1 skips the log.
SPEAKER="$(resolve_speaker 2>/dev/null)" || SPEAKER=""
vox_log "$SPEAKER" "$TEXT" || true
if [[ "${VOX_NO_SIGNOFF:-0}" != "1" && -n "$SPEAKER" ]]; then
	TEXT="${TEXT}. This is ${SPEAKER}."
fi

# --- Resolve + invoke provider ------------------------------------------------

PROVIDER="$(resolve_provider)" || exit 1

if [[ -n "$OUTPUT_FILE" ]]; then
	audio_out="$OUTPUT_FILE"
else
	audio_out="$(mktemp --suffix=.wav)"
	trap 'rm -f "$audio_out"' EXIT
fi

VOX_OUTPUT_FILE="$audio_out" VOX_VOICE="$VOICE" "$PROVIDER" "$TEXT" || {
	echo "Error: provider '$PROVIDER' failed" >&2
	exit 1
}

# If --output was requested, we're done (audio is already at OUTPUT_FILE)
if [[ -n "$OUTPUT_FILE" ]]; then
	trap - EXIT
	exit 0
fi

# --- Wake noise preamble ------------------------------------------------------

# Prepend ~500ms of low-amplitude white noise to a WAV file. This wakes up
# Bluetooth audio sinks that sleep when idle, preventing the first syllable
# from being clipped.
prepend_wake_noise() {
	local wavfile="$1"
	python3 -c '
import wave, random, sys
with wave.open(sys.argv[1], "rb") as w:
    p = w.getparams()
    frames = w.readframes(w.getnframes())
sw = p.sampwidth
n = int(p.framerate * 0.5) * p.nchannels
max_amp = (1 << (8 * sw - 1)) - 1
scale = max(1, max_amp // 55)
bias = 128 if sw == 1 else 0
raw = b"".join(
    ((random.randint(-scale, scale) + bias) & ((1 << (8 * sw)) - 1))
    .to_bytes(sw, "little") for _ in range(n)
)
with wave.open(sys.argv[1], "wb") as w:
    w.setparams(p)
    w.writeframes(raw + frames)
' "$wavfile" 2>/dev/null || true
}

prepend_wake_noise "$audio_out"

# --- Resolve + invoke player --------------------------------------------------

# Serialize audio playback so concurrent agents don't talk over each other (#895).
# flock is util-linux and absent on stock macOS; when it's missing, play directly
# (no mutex, but no breakage on a supported platform).
VOX_LOCK="${VOX_LOCK:-${TMPDIR:-/tmp}/vox-speak.lock}"
vox_play() {
	if command -v flock >/dev/null 2>&1; then
		flock "$VOX_LOCK" "$@"
	else
		"$@"
	fi
}

PLAYER=$(resolve_player)
if [[ -z "$PLAYER" ]]; then
	echo "Error: no audio player found. Set \$VOX_PLAYER, symlink ~/.config/vox/player, or install aplay/paplay/afplay/ffplay." >&2
	exit 1
fi

if $BACKGROUND; then
	bgfile="$(mktemp --suffix=.wav)"
	cp "$audio_out" "$bgfile"
	(
		trap 'rm -f "$bgfile"' EXIT
		# shellcheck disable=SC2086
		vox_play timeout -k 5 60 $PLAYER "$bgfile" || true
	) &>/dev/null &
	disown
else
	# shellcheck disable=SC2086
	vox_play $PLAYER "$audio_out"
fi
