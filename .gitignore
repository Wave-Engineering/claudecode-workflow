# Claude Code local state
.claude/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Backup files from install.sh
*.bak

# Generated files
.status-panel.html

# Transient validate.sh output dump
validate_output.txt

# Python bytecode
__pycache__/
*.pyc

# Node/Bun dependencies
node_modules/
# bun.lock is COMMITTED, not ignored (#1073). Trivy parses lockfiles rather
# than manifests, because a manifest carries ranges (`^5.7.0`) and a lockfile
# carries the resolved version. Ignoring it meant the dependency gate had
# nothing to scan and said so on every run for eleven days.
.install-stamp
.buildinfo

# Build output
dist/

# CI test reports (DM-05 JUnit / DM-06 coverage) — generated, uploaded as artifacts
reports/
.coverage

# Pre-created worktrees for parallel agent execution
.worktrees/

.wtf/
